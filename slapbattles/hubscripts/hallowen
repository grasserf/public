local function GetRandomPlayer()
    local validPlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if player ~= LocalPlayer and char
            and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
            and char:FindFirstChild("entered")
            and char:FindFirstChild("Head")
            and (not char:FindFirstChild("IsInDefaultArena") or char.IsInDefaultArena.Value ~= true)
            and char:FindFirstChild("HumanoidRootPart")
            and not char:FindFirstChild("rock")
            and not char:FindFirstChild("stevebody")
            and not char.Head:FindFirstChild("UnoReverseCard")
            and not char:FindFirstChild("stone")
            and char:FindFirstChild("Ragdolled")
            and char.Humanoid.FloorMaterial ~= Enum.Material.Air
        then
            local y = char.HumanoidRootPart.Position.Y
            if y > -7 and y < 250 then
                table.insert(validPlayers, player)
            end
        end
    end
    if #validPlayers > 0 then
        return validPlayers[math.random(1, #validPlayers)]
    end
    return nil
end


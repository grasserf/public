                            LocalPlayer.Character.HumanoidRootPart.CFrame = dropZonePart.CFrame * CFrame.new(5000, -10, 0) * CFrame.Angles(0, 0, math.rad(90))
	                            wait(.5)
                                LocalPlayer.Character.HumanoidRootPart.CFrame = dropZonePart.CFrame * CFrame.new(-5, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
                            end
                        end
                        break
                    end
                end
            end

            collectCD = false
        end
    })

    Main:AddToggle({
        Name = "Auto attack corn minions",
        Default = false,
        Callback = function(Value)
            AutoAttackCorn = Value

            while AutoAttackCorn do
                local character = LocalPlayer.Character
                local myPos = character and character:GetPivot().Position

                if myPos then
                    local npcFolder = Workspace:FindFirstChild("NPC")
                    if npcFolder then
                        for _, npc in ipairs(npcFolder:GetChildren()) do
                            local candyCorn = npc:FindFirstChild("CandyCorn")
                            if candyCorn and candyCorn:GetAttribute("slappable") == true then
                                local distance = (candyCorn:GetPivot().Position - myPos).Magnitude
                                if distance <= 30 then
                                    attack(candyCorn)
                                end
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end
    })
end

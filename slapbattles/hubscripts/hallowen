local function HasGlove_Function(name)
    if LocalPlayer.leaderstats.Glove.Value == name then
        return true
    end
    EquipGlove(name)
    if LocalPlayer:FindFirstChild("_unlockedGloves") then
        if LocalPlayer._unlockedGloves:FindFirstChild(name) and LocalPlayer._unlockedGloves[name].Value == true then
            return true
        end
        return false
    end
    wait(0.5)
    return LocalPlayer.leaderstats.Glove.Value == name
end

local function HasGlove_ForToggle(enable, name, val, toggleval)
    if not enable then
        if toggleval then
            toggleval(false)
        end
        return false
    end
    if HasGlove_Function(name) then
        return true
    end
    if OrionLib then
        OrionLib:MakeNotification({Name = "Error", Content = "You don't have " .. name .. " glove.", Image = "rbxassetid://7733658504", Time = 5})
    end
    if val then
        val:Set(false)
    end
    if toggleval then
        toggleval(false)
    end
    return false
end


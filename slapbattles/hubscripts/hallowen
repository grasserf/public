            repeat
                firetouchinterest(LocalPlayer.Character:WaitForChild("Head"), Portal, 0)
                firetouchinterest(LocalPlayer.Character:WaitForChild("Head"), Portal, 1)
                task.wait()
            until LocalPlayer.Character:FindFirstChild("entered")
